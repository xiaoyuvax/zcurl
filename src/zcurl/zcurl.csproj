<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>zcurl</AssemblyName>
    <RootNamespace>Zcurl</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Xiaoyuvax</Authors>
    <Description>UTF-8-safe HTTP client for Windows shells: ASCII-only argv, payload through stdin or environment, byte-exact JSON.</Description>
    <RepositoryUrl>https://github.com/xiaoyuvax/zcurl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NativeAOT 单文件发布：dotnet publish -c Release -r win-x64 -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="zcurl.Tests" />
  </ItemGroup>
</Project>
